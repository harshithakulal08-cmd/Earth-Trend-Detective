# NASA Data Detectives - Environment Configuration Example
# Copy this file to .env and fill in your values. Never commit .env to version control!

# Backend Application Settings
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=True

# NASA Earthdata Login Credentials (Required for live data fetching in Step 2)
# Register for free at: https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=your_nasa_earthdata_username
EARTHDATA_PASSWORD=your_nasa_earthdata_password

# Security & CORS Settings
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting (requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=60

# Cache Configuration
CACHE_DIR=./cache
CACHE_TTL_SECONDS=86400

# Frontend Settings (Vite)
VITE_API_BASE_URL=http://localhost:8000/api

